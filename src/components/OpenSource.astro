---
import { openSource } from '../data/site';

function renderDescription(text: string) {
  const parts = text.split(/(`[^`]+`)/g);
  return parts.map((part) => {
    if (part.startsWith('`') && part.endsWith('`')) {
      return { type: 'code' as const, value: part.slice(1, -1) };
    }
    return { type: 'text' as const, value: part };
  });
}
---

<section id="open-source" class="section-pad section-y border-t border-line">
  <div class="mx-auto max-w-content">
    <div class="reveal">
      <p class="eyebrow">Open source</p>
      <h2 class="section-title">Contributions</h2>
      <p class="section-lead">
        Public work on Port’s Terraform tooling — provider resources, imports and reliability fixes.
      </p>
    </div>

    <div class="mt-14 space-y-16">
      {openSource.map((repo, index) => (
        <article class="reveal">
          <h3 class="font-display text-2xl tracking-tight text-ink sm:text-3xl">
            {index + 1}. {repo.name}
          </h3>
          <p class="mt-3 text-sm text-muted">
            Repository:{' '}
            <a
              href={repo.url}
              class="font-medium text-ink underline decoration-dotted underline-offset-4 transition hover:text-accent"
              target="_blank"
              rel="noopener noreferrer"
            >
              {repo.repo}
              <span aria-hidden="true"> ↗</span>
            </a>
            <span class="text-faint"> · {repo.prCount} PRs</span>
          </p>

          <div class="mt-8 overflow-x-auto">
            <table class="w-full min-w-[36rem] border-collapse text-left">
              <thead>
                <tr class="border-b border-line">
                  <th scope="col" class="pb-3 pr-6 text-sm font-medium text-ink">
                    Pull request
                  </th>
                  <th scope="col" class="pb-3 text-sm font-medium text-ink">
                    Contribution
                  </th>
                </tr>
              </thead>
              <tbody>
                {repo.contributions.map((item) => (
                  <tr class="border-b border-line">
                    <td class="py-4 pr-6 align-top whitespace-nowrap">
                      <a
                        href={item.url}
                        class="text-sm text-muted underline decoration-dotted underline-offset-4 transition hover:text-accent"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        #{item.number}
                        <span aria-hidden="true"> ↗</span>
                      </a>
                    </td>
                    <td class="py-4 align-top text-base leading-relaxed text-ink">
                      {renderDescription(item.description).map((part) =>
                        part.type === 'code' ? (
                          <code class="rounded bg-surface px-1.5 py-0.5 text-[0.9em] text-ink">
                            {part.value}
                          </code>
                        ) : (
                          part.value
                        ),
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
