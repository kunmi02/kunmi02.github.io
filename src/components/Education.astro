---
import { education, languages } from '../data/site';
---

<section id="education" class="section-pad section-y border-t border-line">
  <div class="mx-auto max-w-content">
    <div class="reveal">
      <p class="eyebrow">Education</p>
      <h2 class="section-title">Learning path</h2>
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-2">
      <ul class="space-y-0">
        {education.map((item) => (
          <li class="reveal flex flex-col gap-1 border-t border-line py-6 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
            <div>
              <p class="text-lg font-medium text-ink">{item.credential}</p>
              <p class="mt-1 text-muted">{item.school}</p>
            </div>
            {item.period && <p class="shrink-0 text-sm text-faint">{item.period}</p>}
          </li>
        ))}
      </ul>

      <div class="reveal border-t border-line pt-6 lg:border-t-0 lg:border-l lg:pl-10 lg:pt-0">
        <h3 class="text-sm font-medium uppercase tracking-[0.16em] text-faint">Languages</h3>
        <ul class="mt-5 space-y-4">
          {languages.map((lang) => (
            <li class="flex items-baseline justify-between gap-4 border-b border-line pb-4">
              <span class="text-ink">{lang.name}</span>
              {lang.level && <span class="text-sm text-muted">{lang.level}</span>}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
